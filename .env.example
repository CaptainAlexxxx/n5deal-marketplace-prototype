DATABASE_URL="file:./dev.db"
# Left empty on purpose: npm run db:setup generates one into .env.
# Or set your own: openssl rand -base64 32
AUTH_SECRET=""
# Demo accounts on the login page and the demo seed. Remove or set to false for any real deployment.
DEMO_MODE=true
# Only needed when running the production build behind a proxy or on a non-localhost host.
# AUTH_TRUST_HOST=true
